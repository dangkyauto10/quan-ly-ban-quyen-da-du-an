FROM python:3.12-slim
WORKDIR /app
COPY requirements-v2.txt .
RUN pip install --no-cache-dir -r requirements-v2.txt && useradd --uid 10001 --create-home appuser
COPY license_app ./license_app
COPY v2_app.py ./
COPY tools ./tools
USER appuser
ENV APP_MODE=production PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
EXPOSE 8080
CMD ["streamlit", "run", "v2_app.py", "--server.port=8080", "--server.address=0.0.0.0", "--server.headless=true"]
